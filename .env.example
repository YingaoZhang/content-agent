# Copy this file to .env. Text uses Alibaba Cloud Model Studio; images use their own provider.
TEXT_API_KEY=
TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3.7-max
# Disable Qwen thinking mode for faster, non-streaming content generation.
TEXT_ENABLE_THINKING=false
TEXT_MAX_TOKENS=7000
ARTICLE_MIN_CHARS=4500
ARTICLE_TARGET_CHARS=6500

IMAGE_API_KEY=
IMAGE_BASE_URL=https://tokenflux.dev/v1
IMAGE_MODEL=gpt-image-2
REQUEST_TIMEOUT_SECONDS=180
# Retry once after a provider-declared retry_after (for example, a Cloudflare 502).
PROVIDER_RETRY_ATTEMPTS=1
PROVIDER_DEFAULT_RETRY_SECONDS=5
PROVIDER_MAX_RETRY_SECONDS=90
# TokenFlux is typically reached through the local system proxy. Set false only if direct access is known to work.
API_USE_SYSTEM_PROXY=true
